# Keep the HF Spaces build context small — the live app generates its own data.
.git
.venv
__pycache__
*.pyc
*.pyo

# The static Vercel snapshot isn't used by the live Flask app
public/

# Local data (the container builds a fresh DB) and logs
data/
*.log

# Duplicate code copies
SentimentIQ-Code/
SentimentIQ-Submission-Code/

# Docs, reports, office files — not needed at runtime
docs/
handoff/
Charts/
Activity Logs/
Weekly Reports/
*.docx
*.xlsx
*.pdf

# Deploy/scheduler bits that don't belong in the container
.vercel
.github
scripts/
export_static.py
start.sh
push_weekly.sh
.claude/
.env
